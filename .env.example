# Copy to .env and fill in. Values in .env are loaded automatically by scamkg.config.

# Local Ollama server (default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ASU Voyager (OpenAI-compatible API). Base URL should end with /v1 (or wherever /chat/completions lives).
VOYAGER_BASE_URL=
VOYAGER_API_KEY=

# Neo4j (docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scamkg-password
